# OpenAI API Configuration
# Choose one of the following configurations:

# Option 1: Azure OpenAI Resource Endpoint (traditional)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Option 2: Global OpenAI Endpoint (new Azure AI models)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_ENDPOINT=https://models.inference.azure.com
# USE_GLOBAL_OPENAI=1

# Model Configuration
CHAT_MODEL=phi-3-mini
EMBED_MODEL=text-embedding-3-small

# Optional: Force global endpoint for embeddings specifically
# FORCE_GLOBAL_EMBED=1

# Retrieval Configuration
TOP_K=4

# Data & Storage Paths
DATA_DIR=data
STORE_DIR=vector_store
SYSTEM_PROMPT_PATH=docs/system_prompt.md

# Chunking Configuration
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=120

# Optional: Knowledge Base Integrity Check
# KB_HASH=sha256-hash-of-embeddings-pkl-file

# Optional: Deployment Name (for Azure resources)
# DEPLOYMENT_NAME=your-deployment-name

# Debug Mode
# OPENAI_VERBOSE=1
