# Choose one authentication mode:
# 1) Azure resource endpoint mode
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# 2) Global endpoint mode
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://models.inference.azure.com
USE_GLOBAL_OPENAI=0
FORCE_GLOBAL_EMBED=0

# Verbose client selection logs (optional)
OPENAI_VERBOSE=0

# Model/deployment configuration
DEPLOYMENT_NAME=
CHAT_MODEL=phi-3-mini
EMBED_MODEL=text-embedding-3-small

# Retrieval and ingestion configuration
TOP_K=4
DATA_DIR=data
STORE_DIR=vector_store
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=120
SYSTEM_PROMPT_PATH=docs/system_prompt.md
